  <ns prefix="cbc" uri="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"/>
  <ns prefix="xs" uri="http://www.w3.org/2001/XMLSchema"/>
  <pattern id="sk-1">
    <rule context="/ubl:Invoice | /cn:CreditNote">
      <assert id="SK-CIUS-BT-6" flag="warning" test="normalize-space(cbc:DocumentCurrencyCode) = 'EUR' or exists(cbc:TaxCurrencyCode)">[SK-CIUS-BT-6]-Kód účtovnej meny DPH (BT-6) chýba – podmienene vyžadované: ak sa mena faktúry líši od meny, v ktorej sa účtuje DPH (v SR EUR), uvádza sa Kód účtovnej meny DPH.</assert>
      <assert id="SK-CIUS-BT-7" flag="warning" test="exists(cbc:TaxPointDate) or exists(cac:InvoicePeriod) or exists(cac:Delivery/cbc:ActualDeliveryDate)">[SK-CIUS-BT-7]-Dátum uskutočnenia zdaniteľného plnenia (BT-7) chýba – podmienene vyžadované: uvádza sa, ak je dátum dodania/prijatia platby známy a líši sa od dátumu vystavenia (BT-2); faktúra neobsahuje žiadny údaj o dátume dodania (BT-7, BG-14, BT-72).</assert>
      <assert id="SK-CIUS-BR-66" flag="fatal" test="count(cac:PaymentMeans/cac:CardAccount) &lt;= 1">[SK-CIUS-BR-66]-Faktúra musí obsahovať maximálne jeden účet platobnej karty (BG-18). (SK CIUS: BR-66)</assert>
      <assert id="SK-CIUS-BR-67" flag="fatal" test="count(cac:PaymentMeans/cac:PaymentMandate) &lt;= 1">[SK-CIUS-BR-67]-Faktúra musí obsahovať maximálne jeden mandát na platbu (BG-19). (SK CIUS: BR-67)</assert>
      <assert id="SK-CIUS-BR-CO-25" flag="fatal" test="exists(self::cn:CreditNote) or not(xs:decimal(cac:LegalMonetaryTotal/cbc:PayableAmount) &gt; 0) or exists(cbc:DueDate) or exists(cac:PaymentMeans/cbc:PaymentDueDate) or normalize-space(string-join(cac:PaymentTerms/cbc:Note, '')) != ''">[SK-CIUS-BR-CO-25]-V prípade, že je Splatná suma na úhradu (BT-115) kladná, musí byť uvedený Dátum splatnosti (BT-9) alebo Platobné podmienky (BT-20). (SK CIUS: BR-CO-25)</assert>
    </rule>
  </pattern>
  <pattern id="sk-2">
    <rule context="/ubl:Invoice/cac:AccountingSupplierParty/cac:Party | /cn:CreditNote/cac:AccountingSupplierParty/cac:Party">
      <assert id="SK-CIUS-BT-30" flag="warning" test="exists(cac:PartyLegalEntity/cbc:CompanyID)">[SK-CIUS-BT-30]-Identifikátor zákonnej registrácie predávajúceho (BT-30) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČO subjektu pridelené.</assert>
      <assert id="SK-CIUS-BT-31" flag="warning" test="exists(cac:PartyTaxScheme[normalize-space(cac:TaxScheme/cbc:ID) = 'VAT']/cbc:CompanyID)">[SK-CIUS-BT-31]-Identifikátor predávajúceho na účely DPH (BT-31) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČ DPH subjektu pridelené.</assert>
      <assert id="SK-CIUS-BT-33" flag="warning" test="exists(cac:PartyLegalEntity/cbc:CompanyLegalForm)">[SK-CIUS-BT-33]-Dodatočné právne údaje predávajúceho - Právna forma (BT-33) chýba – podmienene vyžadované: § 3a Obchodného zákonníka: právna forma, register a číslo zápisu.</assert>
    </rule>
  </pattern>
  <pattern id="sk-3">
    <rule context="/ubl:Invoice/cac:AccountingSupplierParty/cac:Party/cac:PartyLegalEntity/cbc:CompanyID | /cn:CreditNote/cac:AccountingSupplierParty/cac:Party/cac:PartyLegalEntity/cbc:CompanyID">
      <assert id="SK-CIUS-BT-30-1" flag="warning" test="exists(@schemeID)">[SK-CIUS-BT-30-1]-Identifikátor schémy (BT-30-1) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČO subjektu pridelené.</assert>
    </rule>
  </pattern>
  <pattern id="sk-4">
    <rule context="/ubl:Invoice/cac:AccountingSupplierParty/cac:Party/cac:PostalAddress | /cn:CreditNote/cac:AccountingSupplierParty/cac:Party/cac:PostalAddress">
      <assert id="SK-CIUS-BT-35" flag="fatal" test="normalize-space(string-join(cbc:StreetName, '')) != ''">[SK-CIUS-BT-35]-Chýba Adresa predávajúceho riadok 1 (BT-35) v BG-5 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. a).</assert>
      <assert id="SK-CIUS-BT-37" flag="fatal" test="normalize-space(string-join(cbc:CityName, '')) != ''">[SK-CIUS-BT-37]-Chýba Mesto predávajúceho (BT-37) v BG-5 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. a).</assert>
      <assert id="SK-CIUS-BT-38" flag="fatal" test="normalize-space(string-join(cbc:PostalZone, '')) != ''">[SK-CIUS-BT-38]-Chýba PSČ predávajúceho (BT-38) v BG-5 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. a).</assert>
    </rule>
  </pattern>
  <pattern id="sk-5">
    <rule context="/ubl:Invoice/cac:AccountingCustomerParty/cac:Party | /cn:CreditNote/cac:AccountingCustomerParty/cac:Party">
      <assert id="SK-CIUS-BT-47" flag="warning" test="exists(cac:PartyLegalEntity/cbc:CompanyID)">[SK-CIUS-BT-47]-Identifikátor zákonnej registrácie kupujúceho (BT-47) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČO subjektu pridelené.</assert>
      <assert id="SK-CIUS-BT-48" flag="warning" test="exists(cac:PartyTaxScheme[normalize-space(cac:TaxScheme/cbc:ID) = 'VAT']/cbc:CompanyID)">[SK-CIUS-BT-48]-Identifikátor kupujúceho na účely DPH (BT-48) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČ DPH subjektu pridelené.</assert>
    </rule>
  </pattern>
  <pattern id="sk-6">
    <rule context="/ubl:Invoice/cac:AccountingCustomerParty/cac:Party/cac:PartyLegalEntity/cbc:CompanyID | /cn:CreditNote/cac:AccountingCustomerParty/cac:Party/cac:PartyLegalEntity/cbc:CompanyID">
      <assert id="SK-CIUS-BT-47-1" flag="warning" test="exists(@schemeID)">[SK-CIUS-BT-47-1]-Identifikátor schémy (BT-47-1) chýba – podmienene vyžadované: vyžaduje sa, ak bolo IČO subjektu pridelené.</assert>
    </rule>
  </pattern>
  <pattern id="sk-7">
    <rule context="/ubl:Invoice/cac:AccountingCustomerParty/cac:Party/cac:PostalAddress | /cn:CreditNote/cac:AccountingCustomerParty/cac:Party/cac:PostalAddress">
      <assert id="SK-CIUS-BT-50" flag="fatal" test="normalize-space(string-join(cbc:StreetName, '')) != ''">[SK-CIUS-BT-50]-Chýba Adresa kupujúceho riadok 1 (BT-50) v BG-8 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. b).</assert>
      <assert id="SK-CIUS-BT-52" flag="fatal" test="normalize-space(string-join(cbc:CityName, '')) != ''">[SK-CIUS-BT-52]-Chýba Mesto kupujúceho (BT-52) v BG-8 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. b).</assert>
      <assert id="SK-CIUS-BT-53" flag="fatal" test="normalize-space(string-join(cbc:PostalZone, '')) != ''">[SK-CIUS-BT-53]-Chýba PSČ kupujúceho (BT-53) v BG-8 – SK CIUS: vyžaduje sa, § 74 ods. 1 písm. b).</assert>
    </rule>
  </pattern>
  <pattern id="sk-8">
    <rule context="/ubl:Invoice/cac:TaxRepresentativeParty/cac:PostalAddress | /cn:CreditNote/cac:TaxRepresentativeParty/cac:PostalAddress">
      <assert id="SK-CIUS-BT-64" flag="fatal" test="normalize-space(string-join(cbc:StreetName, '')) != ''">[SK-CIUS-BT-64]-Chýba Adresa daňového zástupcu riadok 1 (BT-64) v BG-12 – SK CIUS: podmienene vyžadované: vyžaduje sa iba v prípade, ak sa transakcie zúčastňuje daňový zástupca.</assert>
      <assert id="SK-CIUS-BT-66" flag="fatal" test="normalize-space(string-join(cbc:CityName, '')) != ''">[SK-CIUS-BT-66]-Chýba Mesto daňového zástupcu (BT-66) v BG-12 – SK CIUS: podmienene vyžadované: vyžaduje sa iba v prípade, ak sa transakcie zúčastňuje daňový zástupca.</assert>
      <assert id="SK-CIUS-BT-67" flag="fatal" test="normalize-space(string-join(cbc:PostalZone, '')) != ''">[SK-CIUS-BT-67]-Chýba PSČ daňového zástupcu (BT-67) v BG-12 – SK CIUS: podmienene vyžadované: vyžaduje sa iba v prípade, ak sa transakcie zúčastňuje daňový zástupca.</assert>
    </rule>
  </pattern>
  <pattern id="sk-9">
    <rule context="/ubl:Invoice/cac:TaxTotal/cac:TaxSubtotal[normalize-space(cac:TaxCategory/cbc:ID) = ('E', 'AE', 'K', 'G', 'O')] | /cn:CreditNote/cac:TaxTotal/cac:TaxSubtotal[normalize-space(cac:TaxCategory/cbc:ID) = ('E', 'AE', 'K', 'G', 'O')]">
      <assert id="SK-CIUS-BT-120" flag="warning" test="normalize-space(cac:TaxCategory/cbc:TaxExemptionReason) != ''">[SK-CIUS-BT-120]-Text dôvodu oslobodenia od DPH (BT-120) chýba – podmienene vyžadované: § 74 ods. 1 písm. h) a k): pri oslobodení / prenesení daňovej povinnosti sa uvádza slovná informácia (kód BT-121 nestačí).</assert>
    </rule>
  </pattern>
  <pattern id="sk-10">
    <rule context="/ubl:Invoice/cac:InvoiceLine/cac:Price/cac:AllowanceCharge | /cn:CreditNote/cac:CreditNoteLine/cac:Price/cac:AllowanceCharge">
      <assert id="SK-CIUS-BT-148" flag="warning" test="exists(cbc:BaseAmount)">[SK-CIUS-BT-148]-Cena za položku brutto (BT-148) chýba – podmienene vyžadované: ak sa uvádza zľava z ceny za položku (BT-147), uvádza sa aj cena za položku brutto (BT-148).</assert>
    </rule>
  </pattern>
