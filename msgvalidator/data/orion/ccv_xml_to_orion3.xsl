<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/import_ccv_xsl.py from the production converter 'INVOIC exp ORION 3 XML' (DB extensions and ORION URL removed). Do not edit by hand. -->
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:edi="http://www.ccv.cz" exclude-result-prefixes="edi xs" version="2.0">
    
    
    <xsl:output method="xml" encoding="utf-8" indent="yes"/>
    
    <xsl:param name="intNum">00001</xsl:param>
    <xsl:param name="msgNum">00010</xsl:param>

    <xsl:function name="edi:parseDate">
        <xsl:param name="arg"/>
<!--        <xsl:if test="not(empty($arg))">-->
        <xsl:if test="normalize-space($arg)!=''">
            <xsl:value-of select="substring($arg,7,4)"/>
            <xsl:text>-</xsl:text>
            <xsl:value-of select="substring($arg,4,2)"/>
            <xsl:text>-</xsl:text>
            <xsl:value-of select="substring($arg,1,2)"/>
        </xsl:if>
    </xsl:function>
  
    <xsl:function name="edi:PrelozTyp">
        <xsl:param name="arg"/>
        <xsl:if test="$arg!=''">
            <xsl:choose>
                <xsl:when test="$arg='ODBR'">BY</xsl:when>
                <xsl:when test="$arg='DODV'">SU</xsl:when>
                <xsl:when test="$arg='FM'">IV</xsl:when>
                <xsl:when test="$arg='PRJM'">SN</xsl:when>
                <xsl:when test="$arg='DSKL'">SF</xsl:when>
                <xsl:when test="$arg='MDOD'">DP</xsl:when>
                <xsl:when test="$arg='KS'">UC</xsl:when>
                <xsl:when test="$arg='VF'">II</xsl:when>
            </xsl:choose>
        </xsl:if>
    </xsl:function>
    
    <xsl:function name="edi:IsNumber" as="xs:boolean">
        <xsl:param name="arg"/>
        <xsl:choose>
            <xsl:when test="$arg castable as xs:decimal">
                <xsl:value-of select="1"/>
            </xsl:when>
            <xsl:otherwise>
                <xsl:value-of select="0"/>
            </xsl:otherwise>
        </xsl:choose>
    </xsl:function>
    
    <xsl:function name="edi:IsNoZeroNumber" as="xs:boolean">
        <xsl:param name="arg"/>
        <xsl:value-of select="edi:IsNumber($arg) and number($arg)!=0"/>
    </xsl:function>
    
    <xsl:template match="/INVOIC">
        <xsl:variable name="OrionURL"><xsl:value-of select="'Not requested'"/></xsl:variable>
        
        <xsl:variable name="vstup" select="/INVOIC"/>
        <orion_message>
            <header>
                <message_type>INVOIC</message_type>
                <version>3.0.7</version>
                <message_id><xsl:value-of select="$msgNum"/></message_id>
                <creation_date><xsl:value-of select="format-dateTime(current-dateTime(),'[Y0001]-[M01]-[D01]')"/></creation_date>
                <creation_time><xsl:value-of select="format-dateTime(current-dateTime(),'[H01]:[m01]')"/></creation_time>
                <receiver><xsl:value-of select="HDR/ADR_ZPR"/></receiver>
                <sender>
                    <xsl:choose>
                        <xsl:when test="HDR/ODL_ZPR!=''">
                            <xsl:value-of select="HDR/ODL_ZPR"/>        
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:value-of select="HDR/ROZL_DODV"/>
                        </xsl:otherwise>
                    </xsl:choose>
                </sender>
                <test_flag><xsl:value-of select="HDR/TEST_PRIZNAK"/></test_flag>
                <xsl:if test="KONVERZE/ZDROJ_ZPR!=''">
                    <message_source><xsl:value-of select="upper-case(KONVERZE/ZDROJ_ZPR)"/></message_source>    
                </xsl:if>
            </header>
            <body>
                <message_header>
                        <xsl:variable name="temp">
                            <doc_number><xsl:value-of select="HDR/CIS_DKL"/></doc_number>                            
                            <doc_type><xsl:value-of select="HDR/DRUH_DKL"/></doc_type>                            
                            <doc_function>
                                <xsl:choose>
                                    <xsl:when test="HDR/FCE_ZPRAVY!=''">
                                        <xsl:value-of select="HDR/FCE_ZPRAVY"/>
                                    </xsl:when>
                                    <xsl:otherwise>
                                        <xsl:text>9</xsl:text>
                                    </xsl:otherwise>
                                </xsl:choose>
                            </doc_function>                            
                            <issue_date><xsl:value-of select="edi:parseDate(HDR/DTM_VYSTAV)"/></issue_date>                            
                            <tax_date><xsl:value-of select="edi:parseDate(HDR/DTM_USK_ZDAN_PLN)"/></tax_date>                            
                            <despatch_date><xsl:value-of select="edi:parseDate(HDR/DTM_VYSKLAD)"/></despatch_date>                            
                            <delivery_date><xsl:value-of select="edi:parseDate(HDR/DTM_DODANI)"/></delivery_date>                           
                            <invoice_period_start><xsl:value-of select="edi:parseDate(HDR/FAKTURACE_OD)"/></invoice_period_start>
                            <invoice_period_end><xsl:value-of select="edi:parseDate(HDR/FAKTURACE_DO)"/></invoice_period_end>                            
                            <due_date><xsl:value-of select="edi:parseDate(HDR/DTM_SPLATNOSTI)"/></due_date>                            
                            <payment_means><xsl:value-of select="HDR/ZPSB_UHRADY"/></payment_means>                            
                            <currency_code><xsl:value-of select="HDR/KOD_MENY"/></currency_code>
                            
                            <currency_target_code><xsl:value-of select="HDR/MENA_DPH"/></currency_target_code>
                            
                            <currency_exchange_rate><xsl:value-of select="HDR/KURZ"/></currency_exchange_rate>
                            <currency_rate_value><xsl:value-of select="HDR/MNOZSTVI_KURZU"/></currency_rate_value>
                            <currency_exchange_date><xsl:value-of select="edi:parseDate(HDR/DTM_KRZ)"/></currency_exchange_date>
                            <registration><xsl:value-of select="HDR/ZAPIS_OR"/></registration>
                            <regulatory_information><xsl:value-of select="HDR/ZAPIS_DAN_ZAKONY"/></regulatory_information>                                                                              
                            <!--<xsl:if test="HDR/PRIZNAK_AE!=''">
                                <reverse_charge><xsl:value-of select="if (HDR/PRIZNAK_AE='A') then 1 else 0"/></reverse_charge>
                            </xsl:if>-->                            
                            <xsl:choose>
                                <xsl:when test="HDR/PRIZNAK_AE!=''">
                                    <reverse_charge><xsl:value-of select="HDR/PRIZNAK_AE"/></reverse_charge>
                                </xsl:when>
                                <xsl:otherwise>
                                    <reverse_charge>N</reverse_charge>
                                </xsl:otherwise>
                            </xsl:choose>                      
                            <country_of_origin><xsl:value-of select="HDR/KOD_ZEME"/></country_of_origin>
                            <contract_number><xsl:value-of select="HDR/CIS_SMLOUVY"/></contract_number>
                            <order_number><xsl:value-of select="HDR/CIS_OBJ_ODBR"/></order_number>
                            <order_number_date><xsl:value-of select="edi:parseDate(HDR/DTM_VYST_OBJ)"/></order_number_date>
                            <order_number_time><xsl:value-of select="HDR/CAS_VYST_OBJ"/></order_number_time>
                            <supplier_order_number><xsl:value-of select="HDR/CIS_OBJ_DODV"/></supplier_order_number>
                            <supplier_order_number_date><xsl:value-of select="edi:parseDate(HDR/DTM_PRIJ_OBJ)"/></supplier_order_number_date>
                            <supplier_order_number_time><xsl:value-of select="HDR/CAS_PRIJ_OBJ"/></supplier_order_number_time>
                            <despatch_advice_number><xsl:value-of select="HDR/CIS_DL"/></despatch_advice_number>                          
                            <despatch_advice_date><xsl:value-of select="edi:parseDate(HDR/DTM_VYST_DL)"/></despatch_advice_date>
                            <despatch_advice_time><xsl:value-of select="HDR/CAS_VYST_DL"/></despatch_advice_time>
                            <receiving_advice_number><xsl:value-of select="HDR/CIS_RECADV"/></receiving_advice_number>
                            <receiving_advice_date><xsl:value-of select="edi:parseDate(HDR/DTM_RECADV)"/></receiving_advice_date>
                            <receiving_advice_time><xsl:value-of select="HDR/CAS_RECADV"/></receiving_advice_time>
                            <reclamation_number><xsl:value-of select="HDR/CIS_REKLAM"/></reclamation_number>
                            <date_of_reclamation><xsl:value-of select="edi:parseDate(HDR/DTM_REKLAM)"/></date_of_reclamation>
                            <previous_comdis_number><xsl:value-of select="HDR/CIS_COMDIS"/></previous_comdis_number>
                            <previous_comdis_date><xsl:value-of select="edi:parseDate(HDR/DTM_COMDIS)"/></previous_comdis_date>
                            <previous_comdis_time><xsl:value-of select="HDR/CAS_COMDIS"/></previous_comdis_time>
                            <meaning_of_reference_number><xsl:value-of select="HDR/VYZ_REF_CIS_FAK"/></meaning_of_reference_number>
                            <reference_number><xsl:value-of select="HDR/REF_CIS_FAKT"/></reference_number>
                            <reference_number_date><xsl:value-of select="edi:parseDate(HDR/DTM_K_REF_CIS)"/></reference_number_date>
                            <reference_number_time><xsl:value-of select="HDR/CAS_K_REF_CIS"/></reference_number_time>
                            <originators_reference><xsl:value-of select="HDR/CIS_INVOICE_LIST"/></originators_reference>
                            <originators_reference_date><xsl:value-of select="edi:parseDate(HDR/DTM_INVOICE_LIST)"/></originators_reference_date>
                            <originators_reference_time><xsl:value-of select="HDR/CAS_INVOICE_LIST"/></originators_reference_time>
                            <reference_number_free><xsl:value-of select="HDR/CIS_REF_FREE"/></reference_number_free>
                            <reference_number_free_date><xsl:value-of select="edi:parseDate(HDR/DTM_REF_FREE)"/></reference_number_free_date>
                            
                            <reference_number_free_time/>
                            
                            <promotion_deal><xsl:value-of select="HDR/PROMO"/></promotion_deal>
                            <special_condition><xsl:value-of select="HDR/SPEC_PODM_FA"/></special_condition>
                            <reason_of_issue><xsl:value-of select="AAW/DUVOD_OPR_DOKL"/></reason_of_issue>
                            
                            <!-- pokud existuje sekce SKONTA, tak se použije sekce skonta, jinak se použije tento zápis -->
                            <xsl:if test="count(SKONTO)=0">
                                <discount_due_date><xsl:value-of select="edi:parseDate(HDR/DTM_SKONTO_PLATBA)"/></discount_due_date>
                                <discount_rate><xsl:value-of select="HDR/SKONTO_PLATBA_PROC"/></discount_rate>
                                <discount_amount><xsl:value-of select="HDR/SKONTO_PLATBA_ABS"/></discount_amount>
                            </xsl:if>
                            
                            <free_text_1><xsl:value-of select="TXT[1]/TEXT"/></free_text_1>
                            <free_text_2><xsl:value-of select="TXT[1]/TEXT_2"/></free_text_2>
                            <free_text_3><xsl:value-of select="TXT[1]/TEXT_3"/></free_text_3>
                            <free_text_4><xsl:value-of select="TXT[1]/TEXT_4"/></free_text_4>
                            <free_text_5><xsl:value-of select="TXT[1]/TEXT_5"/></free_text_5>
                            <free_text_6><xsl:value-of select="TXT[2]/TEXT"/></free_text_6>
                            <free_text_7><xsl:value-of select="TXT[2]/TEXT_2"/></free_text_7>
                            <free_text_8><xsl:value-of select="TXT[2]/TEXT_3"/></free_text_8>
                            <free_text_9><xsl:value-of select="TXT[2]/TEXT_4"/></free_text_9>
                            <free_text_10><xsl:value-of select="TXT[2]/TEXT_5"/></free_text_10>     
                            
                            <legislation_free_text><xsl:value-of select="HDR/VOLNY_TEXT_ZAKONY"/></legislation_free_text>
                            
                            <orion_url><xsl:value-of select="$OrionURL"/></orion_url>
                        </xsl:variable>
                        <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                    
                        <!-- Proměnná $PARTY/NAD poskládaná z hlavičky faktury -->                   
                        <xsl:variable name="PARTY">
                            <xsl:variable name="typ_op" select="('ODBR','DODV','FM','PRJM','DSKL','MDOD','KS','VF')"/>
                            <xsl:for-each select="$typ_op">
                                <xsl:variable name="aktual" select="."/>
                                <NAD>
                                    <xsl:variable name="temp">
                                        <TYP_PART><xsl:value-of select="edi:PrelozTyp($aktual)"/></TYP_PART>
                                        <GLN_PART><xsl:value-of select="$vstup/HDR/*[name()=concat('ROZL_',$aktual)]"/></GLN_PART>
                                        <ICO_PART><xsl:value-of select="$vstup/HDR/*[name()=concat('ICO_',$aktual)]"/></ICO_PART>
                                        <DIC_PART><xsl:value-of select="$vstup/HDR/*[name()=concat('DIC_',$aktual)]"/></DIC_PART>
                                        <NAZEV_PART><xsl:value-of select="$vstup/HDR/*[name()=concat('NZV_',$aktual)]"/></NAZEV_PART>
                                        <ADR_ULICE><xsl:value-of select="$vstup/HDR/*[name()=concat('ADR_',$aktual,'_1')]"/></ADR_ULICE>
                                        <ADR_MISTO><xsl:value-of select="$vstup/HDR/*[name()=concat('ADR_',$aktual,'_2')]"/></ADR_MISTO>
                                        <ADR_PSC><xsl:value-of select="$vstup/HDR/*[name()=concat('ADR_',$aktual,'_3')]"/></ADR_PSC>
                                        <ADR_ZEME><xsl:value-of select="$vstup/HDR/*[name()=concat('ADR_',$aktual,'_4')]"/></ADR_ZEME>
                                        <SK_DIC_PART><xsl:value-of select="$vstup/HDR/*[name()=concat('DID_',$aktual)]"/></SK_DIC_PART>
                                        <IDENT_KONTAKT><xsl:value-of select="$vstup/HDR/*[name()=concat('IDENT_KONTAKT_',$aktual)]"/></IDENT_KONTAKT>
                                        <KONTAKT><xsl:value-of select="$vstup/HDR/*[name()=concat('KONTAKT_',$aktual)]"/></KONTAKT>
                                        <TEL><xsl:value-of select="$vstup/HDR/*[name()=concat('TEL_',$aktual)]"/></TEL>
                                        <FAX><xsl:value-of select="$vstup/HDR/*[name()=concat('FAX_',$aktual)]"/></FAX>
                                        <EMAIL><xsl:value-of select="$vstup/HDR/*[name()=concat('EMAIL_',$aktual)]"/></EMAIL>
                                        <xsl:if test="$aktual='DODV'">
                                            <ACCOUNT_NUMBER><xsl:value-of select="$vstup/HDR/BANK_UCET"/></ACCOUNT_NUMBER>
                                            <BANK_CODE><xsl:value-of select="$vstup/HDR/SMER_KOD_BNK"/></BANK_CODE>
                                            <BANK_NAME><xsl:value-of select="$vstup/HDR/NZV_BANK"/></BANK_NAME>
                                            <IBAN><xsl:value-of select="$vstup/HDR/IBAN"/></IBAN>
                                            <SWIFT><xsl:value-of select="$vstup/HDR/SWIFT"/></SWIFT>
                                            <CONSTANT_SYMBOL><xsl:value-of select="$vstup/HDR/KONST_SYMB"/></CONSTANT_SYMBOL>
                                            <VARIABLE_SYMBOL><xsl:value-of select="$vstup/HDR/VARIAB_SYMB"/></VARIABLE_SYMBOL>
                                            <SPECIFIC_SYMBOL><xsl:value-of select="$vstup/HDR/SPEC_SYMB"/></SPECIFIC_SYMBOL>
                                            <ID_ADD_YC1><xsl:value-of select="$vstup/HDR/*[name()=concat('ROZL_',$aktual,'_KOD')]"/></ID_ADD_YC1>                                            
                                        </xsl:if>
                                    </xsl:variable>
                                    <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                                </NAD>
                            </xsl:for-each>
                        </xsl:variable>
                    
                    <!-- Odstranění segmentů NAD které neobsahují kromě typu jinak žádná data -->
                    <xsl:variable name="PARTY3">
                        <xsl:copy-of select="$PARTY/NAD[*[name()!='TYP_PART']!='']"/>
                    </xsl:variable>
                    
                    <!-- Všechny Párty poskládané dohromady, přes které pojedeme for-each aby se nic neztratilo-->
                    <xsl:variable name="PREHLED-TYP">
                        <xsl:copy-of select="$PARTY/NAD[*[name()!='TYP_PART']!='']"/>
                        <xsl:copy-of select="$vstup/NAD"/>
                    </xsl:variable>
                    
                    <!-- Průchod všemi typy PAR a výpis těch hodnot které nejsou prázdné, přednost má HDR -->
                    <xsl:for-each-group select="$PREHLED-TYP/NAD" group-by="TYP_PART">
                        <party>
                            <xsl:variable name="typ-part" select="TYP_PART"/>
                            <xsl:variable name="temp">
                               <party_qualifier><xsl:value-of select="TYP_PART"/></party_qualifier>
                                <party_id><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/GLN_PART!='') then $PARTY3/NAD[TYP_PART=$typ-part]/GLN_PART else $vstup/NAD[TYP_PART=$typ-part]/GLN_PART"/></party_id>
                                <party_description><xsl:value-of select="$vstup/NAD[TYP_PART=$typ-part]/PART_DESC"/></party_description>
                                <party_name><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/NAZEV_PART!='') then $PARTY3/NAD[TYP_PART=$typ-part]/NAZEV_PART else $vstup/NAD[TYP_PART=$typ-part]/NAZEV_PART"/></party_name>
                                <street><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ADR_ULICE!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ADR_ULICE else $vstup/NAD[TYP_PART=$typ-part]/ADR_ULICE"/></street>
                                <place><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ADR_MISTO!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ADR_MISTO else $vstup/NAD[TYP_PART=$typ-part]/ADR_MISTO"/></place>
                                <postcode><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ADR_PSC!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ADR_PSC else $vstup/NAD[TYP_PART=$typ-part]/ADR_PSC"/></postcode>
                                <country_code><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ADR_ZEME!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ADR_ZEME else $vstup/NAD[TYP_PART=$typ-part]/ADR_ZEME"/></country_code>
                                <country_name><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ADR_ZEME_SLOVY!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ADR_ZEME_SLOVY else $vstup/NAD[TYP_PART=$typ-part]/ADR_ZEME_SLOVY"/></country_name>
                                <company_id><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ICO_PART!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ICO_PART else $vstup/NAD[TYP_PART=$typ-part]/ICO_PART"/></company_id>
                                <tax_id><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/DIC_PART!='') then $PARTY3/NAD[TYP_PART=$typ-part]/DIC_PART else $vstup/NAD[TYP_PART=$typ-part]/DIC_PART"/></tax_id>
                                <vat_id><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/SK_DIC_PART!='') then $PARTY3/NAD[TYP_PART=$typ-part]/SK_DIC_PART else $vstup/NAD[TYP_PART=$typ-part]/SK_DIC_PART"/></vat_id>
                                <contact_type><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/IDENT_KONTAKT!='') then $PARTY3/NAD[TYP_PART=$typ-part]/IDENT_KONTAKT else $vstup/NAD[TYP_PART=$typ-part]/IDENT_KONTAKT"/></contact_type>
                                <contact_name><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/KONTAKT!='') then $PARTY3/NAD[TYP_PART=$typ-part]/KONTAKT else $vstup/NAD[TYP_PART=$typ-part]/KONTAKT"/></contact_name>
                                <contact_tel><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/TEL!='') then $PARTY3/NAD[TYP_PART=$typ-part]/TEL else $vstup/NAD[TYP_PART=$typ-part]/TEL"/></contact_tel>
                                <contact_fax><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/FAX!='') then $PARTY3/NAD[TYP_PART=$typ-part]/FAX else $vstup/NAD[TYP_PART=$typ-part]/FAX"/></contact_fax>
                                <contact_email><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/EMAIL!='') then $PARTY3/NAD[TYP_PART=$typ-part]/EMAIL else $vstup/NAD[TYP_PART=$typ-part]/EMAIL"/></contact_email>
                                <account_number><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ACCOUNT_NUMBER!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ACCOUNT_NUMBER else $vstup/NAD[TYP_PART=$typ-part]/ACCOUNT_NUMBER"/></account_number>
                                <bank_code><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/BANK_CODE!='') then $PARTY3/NAD[TYP_PART=$typ-part]/BANK_CODE else $vstup/NAD[TYP_PART=$typ-part]/BANK_CODE"/></bank_code>
                                <bank_name><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/BANK_NAME!='') then $PARTY3/NAD[TYP_PART=$typ-part]/BANK_NAME else $vstup/NAD[TYP_PART=$typ-part]/BANK_NAME"/></bank_name>
                                <iban><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/IBAN!='') then $PARTY3/NAD[TYP_PART=$typ-part]/IBAN else $vstup/NAD[TYP_PART=$typ-part]/IBAN"/></iban>
                                <swift><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/SWIFT!='') then $PARTY3/NAD[TYP_PART=$typ-part]/SWIFT else $vstup/NAD[TYP_PART=$typ-part]/SWIFT"/></swift>
                                <constant_symbol><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/CONSTANT_SYMBOL!='') then $PARTY3/NAD[TYP_PART=$typ-part]/CONSTANT_SYMBOL else $vstup/NAD[TYP_PART=$typ-part]/CONSTANT_SYMBOL"/></constant_symbol>
                                <variable_symbol><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/VARIABLE_SYMBOL!='') then $PARTY3/NAD[TYP_PART=$typ-part]/VARIABLE_SYMBOL else $vstup/NAD[TYP_PART=$typ-part]/VARIABLE_SYMBOL"/></variable_symbol>
                                <specific_symbol><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/SPECIFIC_SYMBOL!='') then $PARTY3/NAD[TYP_PART=$typ-part]/SPECIFIC_SYMBOL else $vstup/NAD[TYP_PART=$typ-part]/SPECIFIC_SYMBOL"/></specific_symbol>
                                <id_add_yc1><xsl:value-of select="if ($PARTY3/NAD[TYP_PART=$typ-part]/ID_ADD_YC1!='') then $PARTY3/NAD[TYP_PART=$typ-part]/ID_ADD_YC1 else $vstup/NAD[TYP_PART=$typ-part]/ID_ADD_YC1"/></id_add_yc1>
                            </xsl:variable>
                            <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                        </party>
                    </xsl:for-each-group>
                    
                    <!-- 10.08.2016 Hotovo sem -->
                    <xsl:if test="count(SKONTO)!=0 and SKONTO/DTM_SKONTO_PLATBA!='' and (SKONTO/SKONTO_PLATBA_PROC!='' or SKONTO/SKONTO_PLATBA_ABS!='')">
                        <xsl:for-each select="SKONTO[DTM_SKONTO_PLATBA!='' and (SKONTO_PLATBA_PROC!='' or SKONTO_PLATBA_ABS!='')]">
                          <skonto>
                              <xsl:variable name="temp">
                                <counter><xsl:value-of select="COUNTER"/></counter>
