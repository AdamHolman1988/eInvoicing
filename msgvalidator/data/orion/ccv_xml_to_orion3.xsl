                                                <vat_rate><xsl:value-of select="format-number(SAZBA_DPH,'#0.00')"/></vat_rate>
                                                <vat_basis><xsl:value-of select="format-number(ZAKLAD_DPH,'########0.00')"/></vat_basis>
                                                <vat_total><xsl:value-of select="format-number(CASTKA_DPH,'########0.00')"/></vat_total>
                                            </vat>
                                        </xsl:for-each>
                                    </xsl:variable>
                                    <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                                </xsl:when>
                            </xsl:choose>
                            
<!--                            Rekapitulace v mistni mene -->
                            <xsl:variable name="typ_vat" select="('0','1','1.2','1.3','1.3AE','2','1AE','1.2AE','2AE')"/>
                            <xsl:for-each select="$typ_vat">
                                <xsl:variable name="cVat" select="."/>
                                <xsl:if test="$vstup/ERT/*[name()=concat('ZAKLAD_DPH_',$cVat,'_TM')]!=''                                      or $vstup/ERT/*[name()=concat('DPH_',$cVat,'_TM')]!=''">
                                    <vat>
                                        <xsl:variable name="temp">
                                            <vat_group><xsl:value-of select="translate(.,'AE','')"/></vat_group>
                                        <xsl:comment><xsl:value-of select="concat('ZAKLAD_DPH_',$cVat,'_TM')"/></xsl:comment>    
                                        <vat_basis><xsl:value-of select="$vstup/ERT/*[name()=concat('ZAKLAD_DPH_',$cVat,'_TM')]"/></vat_basis>
                                            <vat_rate>
                                                <xsl:choose>
                                                    <xsl:when test="$vstup/ERT/*[name()=concat('SAZBA_DPH_',$cVat,'_TM')]!=''">
                                                        <xsl:value-of select="$vstup/ERT/*[name()=concat('SAZBA_DPH_',$cVat,'_TM')]"/>        
                                                    </xsl:when>
                                                    <xsl:when test="$vstup/SUM/*[name()=concat('SAZBA_DPH_',$cVat)]!=''">
                                                        <xsl:value-of select="$vstup/SUM/*[name()=concat('SAZBA_DPH_',$cVat)]"/>        
                                                    </xsl:when>
                                                    <xsl:when test="$cVat='0'">
                                                        <xsl:value-of select="0"/>
                                                    </xsl:when>
                                                </xsl:choose>
                                            </vat_rate>
                                            <vat_total><xsl:value-of select="$vstup/ERT/*[name()=concat('DPH_',$cVat,'_TM')]"/></vat_total>
                                            <reverse_charge>
                                                <xsl:choose>
                                                    <xsl:when test="ends-with($cVat,'AE')">
                                                        <xsl:value-of select="'A'"/>
                                                    </xsl:when>
                                                </xsl:choose>
                                            </reverse_charge>
                                            <local_currency>A</local_currency>
                                        </xsl:variable>
                                        <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                                    </vat>
                                </xsl:if>
                            </xsl:for-each>
                            
                            <xsl:variable name="temp">
                              <vat_total><xsl:value-of select="SUM/DPH_CELKEM"/></vat_total>
                              <excise_duty><xsl:value-of select="SUM/SPOTR_DAN"/></excise_duty>
                            </xsl:variable>
                            <xsl:copy-of select="$temp/*[node() and .!='NaN']"/>
                        </tax_details>
                    </summary>
            </body>
        </orion_message>
</xsl:template>            
</xsl:stylesheet>