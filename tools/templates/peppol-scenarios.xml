<scenarios xmlns="http://www.xoev.de/de/validator/framework/1/scenarios" frameworkVersion="1.0.0">
  <name>MsgValidator – Peppol BIS Billing 3.0 / EN 16931 / SK CIUS</name>
  <author>GRiT s.r.o.</author>
  <date>2026-11-02</date>
  <description>
    <p>Peppol BIS Billing 3.0.21 and CEN EN 16931 validation artefacts 1.3.17 for UBL 2.1 and CII D16B;
      UBL documents with a Slovak seller or buyer additionally run the SK CIUS Schematron (resources/sk).</p>
  </description>

  <scenario>
    <name>Peppol BIS Billing 3.0 + SK CIUS (UBL Invoice)</name>
    <description><p>Seller or buyer in Slovakia: UBL 2.1 Invoice XSD, CEN EN 16931 UBL 1.3.17, Peppol BIS 3.0.21 UBL
      and the Slovak CIUS (transposition v1.13, generated by tools/build_sk_schematron.py)</p></description>
    <namespace prefix="cbc">urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2</namespace>
    <namespace prefix="cac">urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2</namespace>
    <namespace prefix="invoice">urn:oasis:names:specification:ubl:schema:xsd:Invoice-2</namespace>
    <namespace prefix="rep">http://www.xoev.de/de/validator/varl/1</namespace>
    <match>exists(/invoice:Invoice/cbc:CustomizationID[starts-with(normalize-space(.), 'urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0')]) and (exists(/invoice:Invoice/cac:AccountingSupplierParty/cac:Party/cac:PostalAddress/cac:Country/cbc:IdentificationCode[normalize-space(.) = 'SK']) or exists(/invoice:Invoice/cac:AccountingCustomerParty/cac:Party/cac:PostalAddress/cac:Country/cbc:IdentificationCode[normalize-space(.) = 'SK']))</match>
    <validateWithXmlSchema>
      <resource><name>UBL 2.1 Invoice XSD</name><location>resources/ubl/xsd/maindoc/UBL-Invoice-2.1.xsd</location></resource>
    </validateWithXmlSchema>
    <validateWithSchematron>
      <resource><name>CEN EN 16931 UBL 1.3.17</name><location>resources/cen/EN16931-UBL-validation.xslt</location></resource>
    </validateWithSchematron>
    <validateWithSchematron>
      <resource><name>Peppol BIS Billing 3.0.21 UBL</name><location>resources/peppol/PEPPOL-EN16931-UBL.xslt</location></resource>
    </validateWithSchematron>
    <validateWithSchematron>
      <resource><name>SK CIUS 1.13 UBL</name><location>resources/sk/SK-CIUS-UBL.xslt</location></resource>
    </validateWithSchematron>
    <createReport>
      <resource><name>KoSIT default report</name><location>resources/default-report.xsl</location></resource>
    </createReport>
    <acceptMatch>/rep:report/rep:assessment[1]/rep:accept[1]</acceptMatch>
  </scenario>

