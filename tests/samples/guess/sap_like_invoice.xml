      <TaxAmount>55.06</TaxAmount>
    </Price>
    <ProductTax>
      <CountryCode>SK</CountryCode>
      <BaseAmount>289.8</BaseAmount>
      <Rate><DecimalValue>19.0</DecimalValue></Rate>
      <Amount>999.99</Amount>
    </ProductTax>
    <Item>
      <ItemID>000010</ItemID>
      <Quantity>120.0</Quantity>
      <Product><Note>Napoj A 0,5 l</Note></Product>
      <Price>
        <NetAmount>102.0</NetAmount>
